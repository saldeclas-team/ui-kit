# pnpm 11 moved most settings out of .npmrc into pnpm-workspace.yaml.
# See pnpm-workspace.yaml for: nodeLinker, autoInstallPeers,
# strictPeerDependencies, onlyBuiltDependencies.
#
# Keep this file for npm-standard settings (registry, auth tokens) that
# pnpm still reads from here.
registry=https://registry.npmjs.org/
