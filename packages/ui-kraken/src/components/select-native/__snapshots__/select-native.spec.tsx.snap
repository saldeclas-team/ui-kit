exports[`SelectNative snapshots dark palette + selected 1`] = `
<View
  testID="select-native"
>
  <Text
    color="#F9FAFB"
    testID="select-native-label"
  >
    Country
  </Text>
  <View
    backgroundColor="transparent"
    borderColor="#374151"
    borderRadius="$uiRadiusMd"
    borderWidth={0}
    disabled={false}
    minHeight={0}
    paddingHorizontal={0}
    paddingVertical={0}
    testID="select-native-frame"
  >
    <View
      data-menu-title="Country"
      testID="select-native-menu"
    >
      <View
        accessibilityLabel="Country"
