        accessibilityState={
          {
            "disabled": false,
          }
        }
        alignItems="center"
        flex={1}
        justifyContent="space-between"
        testID="select-native-trigger"
      >
        <Text
          color="#0A84FF"
          flexShrink={1}
          fontSize={15}
          fontWeight="500"
          lineHeight={20}
          testID="select-native-trigger-text"
        >
          Two
