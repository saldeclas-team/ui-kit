{
  "name": "ui-kraken",
  "version": "0.10.0",
  "description": "Fully customizable React Native / Expo component library. Ships a UIKitProvider, a coarse per-component token schema, and compound components (Button / Text / Alert) with provider-level and per-instance color overrides — all powered by Tamagui.",
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "ui-kit",
    "components",
    "component-library",
    "tamagui",
    "design-system",
    "ios",
    "android",
    "typescript",
    "button",
    "provider",
    "theme",
    "tokens",
    "ui-kraken"
  ],
  "license": "MIT",
  "author": {
    "name": "saldeclas-team",
    "url": "https://github.com/saldeclas-team"
  },
  "homepage": "https://github.com/saldeclas-team/ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saldeclas-team/ui-kit.git",
    "directory": "packages/ui-kraken"
  },
  "bugs": {
    "url": "https://github.com/saldeclas-team/ui-kit/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.stories.*",
    "!__tests__"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@expo/ui": "*",
    "@gorhom/bottom-sheet": "*",
    "expo-image-picker": "*",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": ">=3.6.0",
    "react-native-web": ">=0.19.0",
    "tamagui": ">=1.100.0"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": true
    },
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": false
    },
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/ui": "~57.0.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "^4.5.3",
    "react-test-renderer": "19.2.3",
    "tamagui": "^2.6.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
